# ==============================================================================
# CompliScan LM — Environment Configuration Template
# Copy this file to .env and configure local values.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=CompliScan LM
API_V1_STR=/api/v1
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL / Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# 1. Local SQLite fallback (default for local test suite):
# DATABASE_URL=sqlite+aiosqlite:///./compliscan.db
# SYNC_DATABASE_URL=sqlite:///./compliscan.db
#
# 2. Supabase PostgreSQL Configuration:
# - DATABASE_URL: Async connection using asyncpg via Supabase Transaction Pooler (Port 6543)
#   Note: prepared statements are disabled in the app for transaction pooler compatibility.
#   Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres?ssl=require
#
# - SYNC_DATABASE_URL: Sync connection using psycopg via Supabase Session Pooler (Port 5432) for Alembic migrations
#   Format: postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./compliscan.db
SYNC_DATABASE_URL=sqlite:///./compliscan.db

# Supabase Integration (Production Identity, Database & Storage)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder
SUPABASE_AUTH_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=compliscan-evidence

# Controlled Development Seed Credentials (used only by backend/scripts/seed_supabase_users.py)
SEED_INSPECTOR_PASSWORD=YourSecureInspectorPassword123!
SEED_REVIEWER_PASSWORD=YourSecureReviewerPassword123!

# Local Storage Fallback (used when Supabase Storage is not connected)
LOCAL_STORAGE_DIR=backend/uploads

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
